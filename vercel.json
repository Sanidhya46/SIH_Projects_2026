{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/simulation", "destination": "/simulation" },
    { "source": "/neer-simulation", "destination": "/Neer_kavach/simulation" },
    { "source": "/saurya-simulation", "destination": "/Saurya_Rakshak/simulation" },
    { "source": "/neer_kavach/simulation", "destination": "/Neer_kavach/simulation" },
    { "source": "/neer-kavach/simulation", "destination": "/Neer_kavach/simulation" },
    { "source": "/saurya_rakshak/simulation", "destination": "/Saurya_Rakshak/simulation" },
    { "source": "/saurya-rakshak/simulation", "destination": "/Saurya_Rakshak/simulation" },
    { "source": "/neer", "destination": "/Neer_kavach" },
    { "source": "/neer-kavach", "destination": "/Neer_kavach" },
    { "source": "/neer_kavach", "destination": "/Neer_kavach" },
    { "source": "/saurya", "destination": "/Saurya_Rakshak" },
    { "source": "/saurya-rakshak", "destination": "/Saurya_Rakshak" },
    { "source": "/saurya_rakshak", "destination": "/Saurya_Rakshak" },
    { "source": "/neer/video", "destination": "/Neer_kavach/video" },
    { "source": "/neer_kavach/video", "destination": "/Neer_kavach/video" },
    { "source": "/neer-kavach/video", "destination": "/Neer_kavach/video" },
    { "source": "/saurya/video", "destination": "/Saurya_Rakshak/video" },
    { "source": "/saurya_rakshak/video", "destination": "/Saurya_Rakshak/video" },
    { "source": "/saurya-rakshak/video", "destination": "/Saurya_Rakshak/video" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
